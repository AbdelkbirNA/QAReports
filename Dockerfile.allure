FROM eclipse-temurin:17-jre-alpine

ARG ALLURE_VERSION=2.21.0

RUN apk add --no-cache curl tar ca-certificates && \
    curl -fsSL https://repo.maven.apache.org/maven2/io/qameta/allure/allure-commandline/${ALLURE_VERSION}/allure-commandline-${ALLURE_VERSION}.tgz -o /tmp/allure.tgz && \
    tar -xzf /tmp/allure.tgz -C /opt && \
    ln -s /opt/allure-${ALLURE_VERSION}/bin/allure /usr/local/bin/allure && \
    rm -f /tmp/allure.tgz

WORKDIR /opt/robotframework/reports
